{
  "name": "dsh-plugin-suite",
  "version": "0.1.0-local.1",
  "private": true,
  "description": "统一管理的 DSH 插件集合：DS Pet 与 Memory。根包仅负责组合。",
  "type": "module",
  "icon": "icon.svg",
  "repository": { "type": "git", "url": "git+ssh://git@github.com/StormPhoenix/dsh-plugin-suite.git" },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dist/*.tgz", "dist/manifest.json", "cordis.patch.yml", "locale", "icon.svg", "README.md", "UPSTREAM.md", "SNAPSHOT.json"],
  "scripts": {
    "release:prepare": "node scripts/prepare-distribution.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "dsh-pet": "file:./dist/dsh-pet-0.3.6-fix.3-local.3.tgz",
    "dsh-memory": "file:./dist/dsh-memory-0.1.0-local.1.tgz"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
