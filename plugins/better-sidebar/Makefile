# Source-only development commands; generated output stays local.
.DEFAULT_GOAL := help

help:
	@echo "Targets: install typecheck lint test build clean"

install:
	pnpm install --ignore-scripts

typecheck:
	pnpm typecheck

lint:
	pnpm lint

test:
	pnpm test

build:
	pnpm build

clean:
	pnpm clean

.PHONY: help install typecheck lint test build clean
